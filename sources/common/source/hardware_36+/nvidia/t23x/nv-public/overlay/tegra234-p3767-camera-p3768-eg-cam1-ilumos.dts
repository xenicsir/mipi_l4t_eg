/dts-v1/;
/plugin/;

#include <dt-bindings/tegra234-p3767-0000-common.h>

/ {
	overlay-name = "Exosens Cameras. CAM1:iLumos";
#ifdef EG_CSI_22PIN
	jetson-header-name = "Jetson 22pin CSI Connector";
#else
	jetson-header-name = "Jetson 24pin CSI Connector";
#endif
	compatible = JETSON_COMPATIBLE_P3768;

	fragment@10 {
		target-path = "/tegra-capture-vi/ports/port@1/endpoint";
		__overlay__ {
			bus-width=<2>;
		};
	};

	fragment@11 {
		target-path = "/bus@0/host1x@13e00000/nvcsi@15a00000/channel@1/ports/port@0/endpoint@2";
		__overlay__ {
			bus-width=<2>;
         remote-endpoint = <&ilumos_out1>;
		};
	};

   // Disable Dione cameras
	fragment@12 {
		target-path = "/bus@0/cam_i2cmux/i2c@1/xenics_dione_ir_c@0e";
		__overlay__ {
         status = "disabled";
		};
	};

	// Enable iLumos
	fragment@13 {
		target-path = "/bus@0/cam_i2cmux/i2c@1/ilumos_c@30";
		__overlay__ {
         status = "okay";
		};
	};

	fragment@20 {
		target-path = "/bus@0/cam_i2cmux/i2c@1/ilumos_c@30/ports/port@0/endpoint";
		__overlay__ {
			bus-width=<2>;
		};
	};

	fragment@21 {
		target-path = "/tegra-camera-platform/modules/module1/drivernode0";
		__overlay__ {
         devname = "ilumos 10-0030";
			proc-device-tree = "/proc/device-tree/cam_i2cmux/i2c@1/ilumos_c@30";
		};
	};

  // Disable other cameras
	fragment@30 {
		target-path = "/bus@0/cam_i2cmux/i2c@1/rbpcv3_imx477_c@1a";
		__overlay__ {
         status = "disabled";
		};
	};
	fragment@31 {
		target-path = "/bus@0/cam_i2cmux/i2c@1/rbpcv2_imx219_c@10";
		__overlay__ {
         status = "disabled";
		};
	};


};
