 * (at your option) any later version.
 *
 * Exosens EG cameras — common DT overlay for NVIDIA Jetson TX2 / TX2i / TX2 NX
 * (tegra186: quill p3310, quill p3489, lanai p3636)
 *
 * Hardware:
 *   CAM0: serial_a, port-index 0, I2C bus 9  (cam_i2cmux i2c@0)
 *   CAM1: serial_c, port-index 2, I2C bus 10 (cam_i2cmux i2c@1)
 *   cam_i2cmux GPIO mux: TEGRA_MAIN_GPIO(C, 4)
 *   CAM0_PWDN:           TEGRA_MAIN_GPIO(N, 0)
 *   CAM1_PWDN:           TEGRA_MAIN_GPIO(N, 3)
 */

#include <dt-bindings/media/camera.h>
#include <dt-bindings/gpio/tegra186-gpio.h>

#define CAM0_PWDN	TEGRA_MAIN_GPIO(N, 0)
#define CAM1_PWDN	TEGRA_MAIN_GPIO(N, 3)
#define CAM_I2C_MUX	TEGRA_MAIN_GPIO(C, 4)

/ {
	fragment@0 {
		target-path = "/";
		__overlay__ {
			host1x {
				vi@15700000 {
					status = "okay";
					num-channels = <2>;
					ports {
						status = "okay";
						#address-cells = <1>;
						#size-cells = <0>;
						port@0 {
							status = "okay";
							reg = <0>;
							endpoint {
								status = "okay";
								port-index = <0>;
								bus-width = <2>;
								/* remote-endpoint already wired to csi_out0 in base DTB */
							};
						};
						port@1 {
							status = "okay";
							reg = <1>;
							endpoint {
								status = "okay";
								port-index = <2>;
								bus-width = <2>;
								/* remote-endpoint already wired to csi_out1 in base DTB */
							};
						};
					};
				};

				nvcsi@150c0000 {
					status = "okay";
					num-channels = <2>;
					#address-cells = <1>;
					#size-cells = <0>;
					channel@0 {
						status = "okay";
						reg = <0>;
						ports {
							status = "okay";
							#address-cells = <1>;
							#size-cells = <0>;
							port@0 {
								status = "okay";
								reg = <0>;
								endpoint@0 {
									status = "okay";
									port-index = <0>;
									bus-width = <2>;
									remote-endpoint = <&xenics_dione_ir_out0>;
								};
							};
							port@1 {
								status = "okay";
								reg = <1>;
							};
						};
					};
					channel@1 {
						status = "okay";
						reg = <1>;
						ports {
							status = "okay";
							#address-cells = <1>;
							#size-cells = <0>;
							port@0 {
								status = "okay";
								reg = <0>;
								endpoint@2 {
									status = "okay";
									port-index = <2>;
									bus-width = <2>;
									remote-endpoint = <&xenics_dione_ir_out1>;
								};
							};
							port@1 {
								status = "okay";
								reg = <1>;
							};
						};
					};
				};
			};

			/* GPIO power-down control */
			gpio@2200000 {
				camera-control-output-low {
					gpio-hog;
					output-low;
					gpios = <CAM0_PWDN 0 CAM1_PWDN 0>;
					label = "cam0-pwdn", "cam1-pwdn";
				};
			};

			/* I2C mux — GPIO-controlled, parent is the camera I2C bus */
			cam_i2cmux {
				compatible = "i2c-mux-gpio";
				#address-cells = <1>;
				#size-cells = <0>;
				i2c-parent = <&cam_i2c>;
				mux-gpios = <&tegra_main_gpio CAM_I2C_MUX GPIO_ACTIVE_HIGH>;

				/* ----------------------------------------------------------------
				 * CAM0  —  serial_a, port-index 0, I2C bus 9
				 * ---------------------------------------------------------------- */
				i2c@0 {
					reg = <0>;
					#address-cells = <1>;
					#size-cells = <0>;

					dione_ir_cam0: xenics_dione_ir_a@0e {
						compatible = "xenics,dioneir", "exosens,dioneir";
						reg = <0x0e>;
						fpga-address = <0x5a 0x5b 0x5c 0x5d>;
						devnode = "video0";
						physical_w = "7.680";
						physical_h = "5.760";
						sensor_model = "dione_ir";
						use_sensor_mode_id = "false";
						reset-gpios = <&tegra_main_gpio CAM0_PWDN GPIO_ACTIVE_HIGH>;

						mode0 { /* DIONE_IR_MODE_640x480_60FPS */
							mclk_khz = "24000";
							num_lanes = "2";
							tegra_sinterface = "serial_a";
							phy_mode = "DPHY";
							discontinuous_clk = "no";
							dpcm_enable = "false";
							cil_settletime = "0";
							active_w = "640";
							active_h = "480";
							mode_type = "rgb";
							pixel_phase = "rgb888";
							csi_pixel_bit_depth = "24";
							readout_orientation = "0";
							line_length = "694";
							pix_clk_hz = "20000000";
							gain_factor = "16";
							exposure_factor = "1000000";
							min_gain_val = "16";
							max_gain_val = "170";
							step_gain_val = "1";
							default_gain = "16";
							min_hdr_ratio = "1";
							max_hdr_ratio = "1";
							framerate_factor = "1000000";
							min_framerate = "40000000";
							max_framerate = "62000000";
							step_framerate = "1";
							default_framerate = "60020000";
							min_exp_time = "13";
							max_exp_time = "683709";
							step_exp_time = "1";
							default_exp_time = "2495";
							embedded_metadata_height = "0";
						};
						mode1 { /* DIONE_IR_MODE_1280x1024_60FPS */
							mclk_khz = "24000";
							num_lanes = "2";
							tegra_sinterface = "serial_a";
							phy_mode = "DPHY";
							discontinuous_clk = "no";
							dpcm_enable = "false";
							cil_settletime = "0";
							active_w = "1280";
							active_h = "1024";
							mode_type = "rgb";
							pixel_phase = "rgb888";
							csi_pixel_bit_depth = "24";
							readout_orientation = "0";
							line_length = "1334";
							pix_clk_hz = "83000000";
							gain_factor = "16";
							exposure_factor = "1000000";
							min_gain_val = "16";
							max_gain_val = "170";
							step_gain_val = "1";
							default_gain = "16";
							min_hdr_ratio = "1";
							max_hdr_ratio = "1";
							framerate_factor = "1000000";
							min_framerate = "40000000";
							max_framerate = "62000000";
							step_framerate = "1";
							default_framerate = "60756000";
							min_exp_time = "13";
							max_exp_time = "683709";
							step_exp_time = "1";
							default_exp_time = "2495";
							embedded_metadata_height = "0";
						};
						mode2 { /* DIONE_IR_MODE_320x240_60FPS */
							mclk_khz = "24000";
							num_lanes = "2";
							tegra_sinterface = "serial_a";
							phy_mode = "DPHY";
							discontinuous_clk = "no";
							dpcm_enable = "false";
							cil_settletime = "0";
							active_w = "320";
							active_h = "240";
							mode_type = "rgb";
							pixel_phase = "rgb888";
							csi_pixel_bit_depth = "24";
							readout_orientation = "0";
							line_length = "1404";
							pix_clk_hz = "20000000";
							gain_factor = "16";
							exposure_factor = "1000000";
							min_gain_val = "16";
							max_gain_val = "170";
							step_gain_val = "1";
							default_gain = "16";
							min_hdr_ratio = "1";
							max_hdr_ratio = "1";
							framerate_factor = "1000000";
							min_framerate = "40000000";
							max_framerate = "62000000";
							step_framerate = "1";
							default_framerate = "60020000";
							min_exp_time = "13";
							max_exp_time = "683709";
							step_exp_time = "1";
							default_exp_time = "2495";
							embedded_metadata_height = "0";
						};
						mode3 { /* DIONE_IR_MODE_1024x768_60FPS */
							mclk_khz = "24000";
							num_lanes = "2";
							tegra_sinterface = "serial_a";
							phy_mode = "DPHY";
							discontinuous_clk = "no";
							dpcm_enable = "false";
							cil_settletime = "0";
							active_w = "1024";
							active_h = "768";
							mode_type = "rgb";
							pixel_phase = "rgb888";
							csi_pixel_bit_depth = "24";
							readout_orientation = "0";
							line_length = "1079";
							pix_clk_hz = "83000000";
							gain_factor = "16";
							exposure_factor = "1000000";
							min_gain_val = "16";
							max_gain_val = "170";
							step_gain_val = "1";
							default_gain = "16";
							min_hdr_ratio = "1";
							max_hdr_ratio = "1";
							framerate_factor = "1000000";
							min_framerate = "40000000";
							max_framerate = "62000000";
							step_framerate = "1";
							default_framerate = "60756000";
							min_exp_time = "13";
							max_exp_time = "683709";
							step_exp_time = "1";
							default_exp_time = "2495";
							embedded_metadata_height = "0";
						};
						ports {
							#address-cells = <1>;
							#size-cells = <0>;
							port@0 {
								reg = <0>;
								xenics_dione_ir_out0: endpoint {
									port-index = <0>;
									bus-width = <2>;
									remote-endpoint = <&csi_in0>;
									link-frequencies = /bits/ 64 <120000000 498000000>;
								};
							};
						};
					};

					eg_ec_cam0: eg_ec_a@16 {
						compatible = "xenics,eg-ec-mipi", "exosens,eg-ec-mipi";
						reg = <0x16>;
						devnode = "video0";
						sensor_model = "eg_ec";
						use_sensor_mode_id = "true";
						status = "disabled";

						mode0 { /* EC_MODE_640x480_RAW16 */
							num_lanes = "2";
							tegra_sinterface = "serial_a";
							phy_mode = "DPHY";
							discontinuous_clk = "yes";
							dpcm_enable = "false";
							cil_settletime = "0";
							active_w = "640";
							active_h = "480";
							line_length = "640";
							mode_type = "raw";
							pixel_phase = "grey";
							csi_pixel_bit_depth = "16";
							pix_clk_hz = "100000000";
							embedded_metadata_height = "0";
						};
						mode1 { /* EC_MODE_640x480_RGB888 */
							num_lanes = "2";
							tegra_sinterface = "serial_a";
							phy_mode = "DPHY";
							discontinuous_clk = "yes";
							dpcm_enable = "false";
							cil_settletime = "0";
							active_w = "640";
							active_h = "480";
							line_length = "640";
							mode_type = "rgb";
							pixel_phase = "rgb888";
							csi_pixel_bit_depth = "24";
							pix_clk_hz = "100000000";
							embedded_metadata_height = "0";
						};
						mode2 { /* EC_MODE_640x480_YUYV */
							num_lanes = "2";
							tegra_sinterface = "serial_a";
							phy_mode = "DPHY";
							discontinuous_clk = "yes";
							dpcm_enable = "false";
							cil_settletime = "0";
							active_w = "640";
							active_h = "480";
							line_length = "640";
							mode_type = "yuv";
							pixel_phase = "yuyv";
							csi_pixel_bit_depth = "16";
							pix_clk_hz = "100000000";
							embedded_metadata_height = "0";
						};
						mode3 { /* EC_MODE_1280x1024_RAW16 */
							num_lanes = "2";
							tegra_sinterface = "serial_a";
							phy_mode = "DPHY";
							discontinuous_clk = "yes";
							dpcm_enable = "false";
							cil_settletime = "0";
							active_w = "1280";
							active_h = "1024";
							line_length = "1280";
							mode_type = "raw";
							pixel_phase = "grey";
							csi_pixel_bit_depth = "16";
							pix_clk_hz = "100000000";
							embedded_metadata_height = "0";
						};
						mode4 { /* EC_MODE_1280x1024_RGB888 */
							num_lanes = "2";
							tegra_sinterface = "serial_a";
							phy_mode = "DPHY";
							discontinuous_clk = "yes";
							dpcm_enable = "false";
							cil_settletime = "0";
							active_w = "1280";
							active_h = "1024";
							line_length = "1280";
							mode_type = "rgb";
							pixel_phase = "rgb888";
							csi_pixel_bit_depth = "24";
							pix_clk_hz = "133333336";
							embedded_metadata_height = "0";
						};
						mode5 { /* EC_MODE_1280x1024_YUYV */
							num_lanes = "2";
							tegra_sinterface = "serial_a";
							phy_mode = "DPHY";
							discontinuous_clk = "yes";
							dpcm_enable = "false";
							cil_settletime = "0";
							active_w = "1280";
							active_h = "1024";
							line_length = "1280";
							mode_type = "yuv";
							pixel_phase = "yuyv";
							csi_pixel_bit_depth = "16";
							pix_clk_hz = "100000000";
							embedded_metadata_height = "0";
						};
						ports {
							#address-cells = <1>;
							#size-cells = <0>;
							port@0 {
								reg = <0>;
								eg_ec_out0: endpoint {
									port-index = <0>;
									bus-width = <2>;
									remote-endpoint = <&csi_in0>;
								};
							};
						};
					};

					ilumos_cam0: ilumos_a@30 {
						compatible = "exosens,ilumos";
						reg = <0x30>;
						sensor_model = "ilumos";
						use_sensor_mode_id = "false";
						status = "disabled";

						mode0 { /* ILUMOS_MODE_2048x2048_RAW16_BE */
							num_lanes = "2";
							tegra_sinterface = "serial_a";
							phy_mode = "DPHY";
							discontinuous_clk = "no";
							dpcm_enable = "false";
							cil_settletime = "0";
							active_w = "2048";
							active_h = "2048";
							line_length = "2048";
							mode_type = "raw";
							pixel_phase = "grey_be";
							csi_pixel_bit_depth = "16";
							pix_clk_hz = "148750000";
							embedded_metadata_height = "0";
							gain_factor = "16";
							exposure_factor = "1000000";
							min_gain_val = "16";
							max_gain_val = "170";
							step_gain_val = "1";
							default_gain = "16";
							min_hdr_ratio = "1";
							max_hdr_ratio = "1";
							framerate_factor = "1000000";
							min_framerate = "40000000";
							max_framerate = "62000000";
							step_framerate = "1";
							default_framerate = "60756000";
							min_exp_time = "13";
							max_exp_time = "683709";
							step_exp_time = "1";
							default_exp_time = "2495";
						};
						mode1 { /* ILUMOS_MODE_2048x1088_RAW16_BE */
							num_lanes = "2";
							tegra_sinterface = "serial_a";
							phy_mode = "DPHY";
							discontinuous_clk = "no";
							dpcm_enable = "false";
							cil_settletime = "0";
							active_w = "2048";
							active_h = "1088";
							line_length = "2048";
							mode_type = "raw";
							pixel_phase = "grey_be";
							csi_pixel_bit_depth = "16";
							pix_clk_hz = "148750000";
							embedded_metadata_height = "0";
							gain_factor = "16";
							exposure_factor = "1000000";
							min_gain_val = "16";
							max_gain_val = "170";
							step_gain_val = "1";
							default_gain = "16";
							min_hdr_ratio = "1";
							max_hdr_ratio = "1";
							framerate_factor = "1000000";
							min_framerate = "40000000";
							max_framerate = "62000000";
							step_framerate = "1";
							default_framerate = "60756000";
							min_exp_time = "13";
							max_exp_time = "683709";
							step_exp_time = "1";
							default_exp_time = "2495";
						};
						mode2 { /* ILUMOS_MODE_1280x1024_RAW16_BE */
							num_lanes = "2";
							tegra_sinterface = "serial_a";
							phy_mode = "DPHY";
							discontinuous_clk = "no";
							dpcm_enable = "false";
							cil_settletime = "0";
							active_w = "1280";
							active_h = "1024";
							line_length = "1280";
							mode_type = "raw";
							pixel_phase = "grey_be";
							csi_pixel_bit_depth = "16";
							pix_clk_hz = "148750000";
							embedded_metadata_height = "0";
							gain_factor = "16";
							exposure_factor = "1000000";
							min_gain_val = "16";
							max_gain_val = "170";
							step_gain_val = "1";
							default_gain = "16";
							min_hdr_ratio = "1";
							max_hdr_ratio = "1";
							framerate_factor = "1000000";
							min_framerate = "40000000";
							max_framerate = "62000000";
							step_framerate = "1";
							default_framerate = "60756000";
							min_exp_time = "13";
							max_exp_time = "683709";
							step_exp_time = "1";
							default_exp_time = "2495";
						};
						mode3 { /* ILUMOS_MODE_2048x2048_RAW14 */
							num_lanes = "2";
							tegra_sinterface = "serial_a";
							phy_mode = "DPHY";
							discontinuous_clk = "no";
							dpcm_enable = "false";
							cil_settletime = "0";
							active_w = "2048";
							active_h = "2048";
							line_length = "2048";
							mode_type = "raw";
							pixel_phase = "grey";
							csi_pixel_bit_depth = "14";
							pix_clk_hz = "148750000";
							embedded_metadata_height = "0";
							gain_factor = "16";
							exposure_factor = "1000000";
							min_gain_val = "16";
							max_gain_val = "170";
							step_gain_val = "1";
							default_gain = "16";
							min_hdr_ratio = "1";
							max_hdr_ratio = "1";
							framerate_factor = "1000000";
							min_framerate = "40000000";
							max_framerate = "62000000";
							step_framerate = "1";
							default_framerate = "60756000";
							min_exp_time = "13";
							max_exp_time = "683709";
							step_exp_time = "1";
							default_exp_time = "2495";
						};
						mode4 { /* ILUMOS_MODE_2048x1088_RAW14 */
							num_lanes = "2";
							tegra_sinterface = "serial_a";
							phy_mode = "DPHY";
							discontinuous_clk = "no";
							dpcm_enable = "false";
							cil_settletime = "0";
							active_w = "2048";
							active_h = "1088";
							line_length = "2048";
							mode_type = "raw";
							pixel_phase = "grey";
							csi_pixel_bit_depth = "14";
							pix_clk_hz = "148750000";
							embedded_metadata_height = "0";
							gain_factor = "16";
							exposure_factor = "1000000";
							min_gain_val = "16";
							max_gain_val = "170";
							step_gain_val = "1";
							default_gain = "16";
							min_hdr_ratio = "1";
							max_hdr_ratio = "1";
							framerate_factor = "1000000";
							min_framerate = "40000000";
							max_framerate = "62000000";
							step_framerate = "1";
							default_framerate = "60756000";
							min_exp_time = "13";
							max_exp_time = "683709";
							step_exp_time = "1";
