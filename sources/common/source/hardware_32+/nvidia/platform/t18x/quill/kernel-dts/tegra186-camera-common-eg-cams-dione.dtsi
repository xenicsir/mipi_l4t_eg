							min_exp_time = "13";
							max_exp_time = "683709";
							step_exp_time = "1";
							default_exp_time = "2495";
						};
						ports {
							#address-cells = <1>;
							#size-cells = <0>;
							port@0 {
								reg = <0>;
								ilumos_out0: endpoint {
									port-index = <0>;
									bus-width = <2>;
									remote-endpoint = <&csi_in0>;
								};
							};
						};
					};

					microlynx_cam0: microlynx_a@51 {
						compatible = "exosens,microlynx";
						reg = <0x51>;
						sensor_model = "microlynx";
						use_sensor_mode_id = "true";
						line-height = <128>;
						status = "disabled";

						mode0 { /* MICROLYNX_MODE_1024x128_RAW16 */
							num_lanes = "2";
							tegra_sinterface = "serial_a";
							phy_mode = "DPHY";
							discontinuous_clk = "no";
							dpcm_enable = "false";
							cil_settletime = "0";
							active_w = "1024";
							active_h = "128";
							line_length = "1024";
							mode_type = "raw";
							pixel_phase = "grey";
							csi_pixel_bit_depth = "16";
