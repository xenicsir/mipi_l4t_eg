						};
						mode5 { /* ILUMOS_MODE_1280x1024_RAW14 */
							num_lanes = "2";
							tegra_sinterface = "serial_a";
							phy_mode = "DPHY";
							discontinuous_clk = "no";
							dpcm_enable = "false";
							cil_settletime = "0";
							active_w = "1280";
							active_h = "1024";
							line_length = "1280";
							mode_type = "raw";
							pixel_phase = "grey";
							csi_pixel_bit_depth = "14";
							pix_clk_hz = "148750000";
							embedded_metadata_height = "0";
