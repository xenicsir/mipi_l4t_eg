+#define GENCP_REG_USER_DEFINED_NAME                             (0x00000184)
+#define GENCP_REG_DEVICE_CAPABILITY                             (0x000001C4)
+#define GENCP_REG_MAX_DEVICE_RESPONSE_TIME                      (0x000001CC)
+#define GENCP_REG_MANIFEST_TABLE_ADDRESS                        (0x000001D0)
