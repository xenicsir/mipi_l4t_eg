+
+static struct i2c_driver microlynx_i2c_driver = {
+   .driver = {
+      .name = "microlynx",
+      .owner = THIS_MODULE,
+      .of_match_table = of_match_ptr(microlynx_of_match),
+   },
+   .probe = microlynx_probe,
+   .remove = microlynx_remove,
+   .id_table = microlynx_id,
+};
+module_i2c_driver(microlynx_i2c_driver);
