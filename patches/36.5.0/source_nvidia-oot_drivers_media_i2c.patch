+static struct file_operations dione_ir_chnod_register_fops = 
+{
+   .owner   = THIS_MODULE,
+   .read    = dione_ir_chnod_read,
+   .write   = dione_ir_chnod_write,
+   .open    = dione_ir_chnod_open,
+   .release = dione_ir_chnod_release,
+};
