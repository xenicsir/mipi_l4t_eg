+				};
+			};
+		};
+	};
+
+	display@13800000 {
+		status = "okay";
+	};
+
+	dce@d800000 {
+		status = "okay";
+	};
+
+	bpmp {
+		i2c {
+			tegra_tmp451: temp-sensor@4c {
+				vdd-supply = <&p3737_vdd_1v8_sys>;
+
+				ext {
