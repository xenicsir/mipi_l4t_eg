+#define CSI_CONFW_ADDRESS_CSI_ERR_HALT_MASK  (BIT(28) | BIT(26) | BIT(24))
+#define CSI_CONFW_DATA_MASK         GENMASK(15, 0)
+
+#define CSIRESET                0x0504
+#define CSIRESET_RESET_CNF_MASK     BIT(1)
+#define CSIRESET_RESET_MODULE_MASK  BIT(0)
