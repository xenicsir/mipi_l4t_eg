+static int ilumos_i2c_read_string(struct i2c_client *client, u32 reg,
+                                  u8 *buf, u16 len)
+{
+   if (len > ILUMOS_STR_MAX)
+      return -EINVAL;
+   return ilumos_i2c_read_register(client, reg, buf, len);
+}
