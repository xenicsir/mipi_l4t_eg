+
+	cam_i2cmux {
+		i2c@0 {
+			status = "okay";
+
+			basler_a@36 {
+				status="okay";
+
+				compatible = "basler,basler-camera";
+				/* I2C device address */
+				reg = <0x36>;
+
+				/* V4L2 device node location */
+				devnode = "video0";
