+      PRINT_DEBUG("\n\rGENCP CLIENT     - Address of RxBuffer:             0x%p", pRxBuffer);
+      PRINT_DEBUG("\n\rGENCP CLIENT     - Address of TxBuffer:             0x%p", pTxBuffer);
