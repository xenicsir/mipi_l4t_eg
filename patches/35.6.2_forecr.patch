+      // Two buffers for rx and tx for i2c send and capture
+      pRxBuffer = (GENCP_MSG*)MEM_ALLOC(sizeof(GENCP_MSG));
+      pTxBuffer = (GENCP_MSG*)MEM_ALLOC(sizeof(GENCP_MSG));
