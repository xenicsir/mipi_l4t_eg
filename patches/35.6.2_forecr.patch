+		modules {
+			cam_module0: module0 {	
+				status = "okay";
+				badge = "jakku_front_RBP194";
+				position = "front";
+				orientation = "1";
+
+				cam_module0_drivernode0: drivernode0 {
+					status = "okay";
+					pcl_id = "v4l2_sensor";
+					devname = "imx219 9-0010";
