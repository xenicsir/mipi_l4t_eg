index 0000000..80cb9d5
--- /dev/null
+++ b/source/public/hardware/nvidia/platform/t18x/quill/kernel-dts/tegra186-camera-common-eg-cams-dione.dtsi
@@ -0,0 +1,1302 @@
+/*
