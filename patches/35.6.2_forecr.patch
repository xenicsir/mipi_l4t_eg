+#define TCLK_TRAILCNT      0x021C
+#define THS_HEADERCNT      0x0220
+#define  THS_HEADERCNT_THS_ZEROCNT_MASK      GENMASK(14, 8)
+#define  THS_HEADERCNT_THS_PREPARECNT_MASK   GENMASK(6, 0)
