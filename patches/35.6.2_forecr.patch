+{
+   struct camera_common_data *s_data = to_camera_common_data(dev);
+   struct dione_ir *priv = (struct dione_ir *)s_data->priv;
+
+   return scnprintf(buf, PAGE_SIZE, "%s\n", priv->serial_number);
+}
+static DEVICE_ATTR_RO(serial_number);
+
