+#define  TCLK_HEADERCNT_TCLK_ZEROCNT_SET(val)   ((val << 8) & TCLK_HEADERCNT_TCLK_ZEROCNT_MASK)
+#define  TCLK_HEADERCNT_TCLK_PREPARECNT_SET(val)   (val & TCLK_HEADERCNT_TCLK_PREPARECNT_MASK)
