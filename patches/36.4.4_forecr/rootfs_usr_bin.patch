+
+    orig_len = self.open_file(idx, 1)
+    print( f'original length: {orig_len}' )
+    if orig_len < 0:
+      return -1
+
+    f_src = io.open(src, "rb")
+
+    ofs = 0
+    total = 0
+    col = 0
+    while length > 0:
+      read = length
+      if read > 4096:
+        read = 4096
+      buf = f_src.read(read)
+
+      retry = 4
+      tmo = 0.5
+      while retry > 0:
+        try:
+          self.last_file_op = 3
+          self.write_reg32(0x10010008, 3)  # FileOperationSelector
+          break
+        except OSError:
+          print( f'Retry: {retry}' )
+          time.sleep(tmo)
+          tmo *= 2
+          retry -= 1
+
+      if retry == 0:
