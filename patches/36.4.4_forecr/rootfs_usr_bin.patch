+        print( f'Verify error at {ofs}' )
+        self.close_file()
+        f_src.close()
+        return -1
+
+      retry = 4
+      tmo = 0.5
+      while retry > 0:
+        try:
+          self.write_reg32(0x1001001c, ofs)     # FileAccessOffset
+          self.write_reg32(0x10010020, read)    # FileAccessLength
+          if not self.exec_file_op(3) :         # write
+            print( "Failed to execute write" )
+            self.close_file()
+            f_src.close()
+            return False
+          else:
+            break
+        except OSError:
+          print( f'Retry: {retry}' )
+          time.sleep(tmo)
+          tmo *= 2
+          retry -= 1
+
+      if retry == 0:
+        print( "Failed to fill FileAccessBuffer" )
+        self.close_file()
+        f_src.close()
+        return -1
+
+      length -= read
+      ofs += read
+      total += read
+      col += 1
+      print( ".", end="", flush=True)
+      if col >= 64 :
+        col = 0
+        print()
+
+    print()
+    self.close_file()
+    f_src.close()
+    print( f'Updated {total} bytes' )
