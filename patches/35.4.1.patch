+      .name = "ilumos",
+      .owner = THIS_MODULE,
+      .of_match_table = of_match_ptr(ilumos_of_match),
+   },
+   .probe = ilumos_probe,
+   .remove = ilumos_remove,
+   .id_table = ilumos_id,
+};
