+static inline int dione_ir_write_reg(struct camera_common_data *s_data,
+      u16 addr, u8 val)
+{
+   int err = 0;
+
+   err = regmap_write(s_data->regmap, addr, val);
+   if (err)
+      dev_err(s_data->dev, "%s: i2c write failed %#x = %#x\n",
+            __func__, addr, val);
+
+   return err;
+}
