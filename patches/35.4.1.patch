+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ *
+ * Exosens EG cameras — common DT overlay for NVIDIA Jetson TX2 / TX2i / TX2 NX
+ * (tegra186: quill p3310, quill p3489, lanai p3636)
+ *
+ * Hardware:
+ *   CAM0: serial_a, port-index 0, I2C bus 9  (cam_i2cmux i2c@0)
+ *   CAM1: serial_c, port-index 2, I2C bus 10 (cam_i2cmux i2c@1)
+ *   cam_i2cmux GPIO mux: TEGRA_MAIN_GPIO(C, 4)
+ *   CAM0_PWDN:           TEGRA_MAIN_GPIO(N, 0)
+ *   CAM1_PWDN:           TEGRA_MAIN_GPIO(N, 3)
+ */
+
+#include <dt-bindings/media/camera.h>
+#include <dt-bindings/gpio/tegra186-gpio.h>
+
+#define CAM0_PWDN	TEGRA_MAIN_GPIO(N, 0)
+#define CAM1_PWDN	TEGRA_MAIN_GPIO(N, 3)
+#define CAM_I2C_MUX	TEGRA_MAIN_GPIO(C, 4)
+
+/ {
+	fragment@0 {
+		target-path = "/";
+		__overlay__ {
+			host1x {
+				vi@15700000 {
+					status = "okay";
+					num-channels = <2>;
+					ports {
+						status = "okay";
+						#address-cells = <1>;
+						#size-cells = <0>;
+						port@0 {
+							status = "okay";
+							reg = <0>;
+							endpoint {
+								status = "okay";
+								port-index = <0>;
+								bus-width = <2>;
+								/* remote-endpoint already wired to csi_out0 in base DTB */
+							};
+						};
+						port@1 {
+							status = "okay";
+							reg = <1>;
+							endpoint {
+								status = "okay";
+								port-index = <2>;
+								bus-width = <2>;
+								/* remote-endpoint already wired to csi_out1 in base DTB */
+							};
+						};
+					};
+				};
+
+				nvcsi@150c0000 {
+					status = "okay";
+					num-channels = <2>;
+					#address-cells = <1>;
+					#size-cells = <0>;
+					channel@0 {
+						status = "okay";
+						reg = <0>;
+						ports {
+							status = "okay";
+							#address-cells = <1>;
+							#size-cells = <0>;
+							port@0 {
+								status = "okay";
+								reg = <0>;
+								endpoint@0 {
+									status = "okay";
+									port-index = <0>;
+									bus-width = <2>;
+									remote-endpoint = <&xenics_dione_ir_out0>;
+								};
+							};
+							port@1 {
+								status = "okay";
+								reg = <1>;
+							};
+						};
+					};
+					channel@1 {
+						status = "okay";
+						reg = <1>;
+						ports {
+							status = "okay";
+							#address-cells = <1>;
+							#size-cells = <0>;
+							port@0 {
+								status = "okay";
+								reg = <0>;
+								endpoint@2 {
+									status = "okay";
+									port-index = <2>;
+									bus-width = <2>;
+									remote-endpoint = <&xenics_dione_ir_out1>;
+								};
+							};
+							port@1 {
+								status = "okay";
+								reg = <1>;
+							};
+						};
+					};
+				};
+			};
+
+			/* GPIO power-down control */
+			gpio@2200000 {
+				camera-control-output-low {
+					gpio-hog;
