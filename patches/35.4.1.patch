+```bash
+#!/bin/bash
+
+# Get JSON output
+CAM_JSON=$(eg_dt_camera_config_get.sh --json)
+
+# Extract specific fields
+BOARD=$(echo "$CAM_JSON" | jq -r '.board.type')
