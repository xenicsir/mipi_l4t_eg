+void GENCPCLIENT_Cleanup(void)
+{
+   nb_timer_delete_all();
+   MEM_FREE(pRxBuffer);
+   pRxBuffer = NULL;
+   MEM_FREE(pTxBuffer);
+   pTxBuffer = NULL;
+   gGencpInitWasSuccessfull = false;
+   PRINT_INFO("GENCP Client cleaned up\n");
