+static int dione_ir_open(struct v4l2_subdev *sd, struct v4l2_subdev_fh *fh)
+{
+   struct i2c_client *client = v4l2_get_subdevdata(sd);
+
+   dev_dbg(&client->dev, "%s:\n", __func__);
+   return 0;
+}
