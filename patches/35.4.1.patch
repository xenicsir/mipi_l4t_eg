+static int dione_ir_find_frmfmt(u32 width, u32 height)
+{
+   u32 i;
+
+   for (i = 0; i < ARRAY_SIZE(dione_ir_frmfmt); i++) {
+      const struct camera_common_frmfmt *fmt = dione_ir_frmfmt + i;
