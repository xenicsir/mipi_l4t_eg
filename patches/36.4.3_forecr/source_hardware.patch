+		__overlay__ { status = "disabled"; };
+	};
+	fragment@2 {
+		target-path = "/bus@0/i2c@31e0000/rbpcv2_imx219_a@10";
+		__overlay__ { status = "disabled"; };
+	};
+	fragment@3 {
+		target-path = "/bus@0/i2c@3180000/rbpcv2_imx219_c@10";
+		__overlay__ { status = "disabled"; };
+	};
+};
diff --git a/source/hardware/nvidia/t23x/nv-public/overlay/tegra234-p3767-camera-common-eg-cams-dione.dtsi b/source/hardware/nvidia/t23x/nv-public/overlay/tegra234-p3767-camera-common-eg-cams-dione.dtsi
