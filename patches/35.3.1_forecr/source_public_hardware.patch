+		status = "okay";
+		spi@0 {
+			status = "okay";
+			compatible = "tegra-spidev";
+			reg = <0x0>;
+			spi-max-frequency = <20000000>;
+
+			controller-data {
+				nvidia,enable-hw-based-cs;
+				nvidia,rx-clk-tap-delay = <0x10>;
+				nvidia,tx-clk-tap-delay = <0x0>;
+			};
+		};
+	};
+
+
+	serial@3100000 { // UART1 (uarta) RS422
+		status = "okay";
+	};
+
+	serial@3110000 { // UART0 (uartb) RS232
+		status = "okay";
+	};
+
+};
