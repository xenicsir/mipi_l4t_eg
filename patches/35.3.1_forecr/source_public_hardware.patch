+						orientation = "1";
+						cam_module1_drivernode0: drivernode0 {
+							pcl_id = "v4l2_sensor";
+							devname = "dione_ir 8-0016";
+							proc-device-tree = "/proc/device-tree/cam_i2cmux/i2c@1/xenics_dione_ir_e@0e";
+						};
