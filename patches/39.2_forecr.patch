diff --git a/source/nvidia-oot/drivers/media/platform/tegra/camera/vi/channel.c b/source/nvidia-oot/drivers/media/platform/tegra/camera/vi/channel.c
index 33700bb..9e1ecc8 100644
--- a/source/nvidia-oot/drivers/media/platform/tegra/camera/vi/channel.c
+++ b/source/nvidia-oot/drivers/media/platform/tegra/camera/vi/channel.c
@@ -2024,7 +2024,38 @@ static void tegra_channel_populate_dev_info(struct tegra_camera_dev_info *cdev,
 		cdev->pixel_rate = pixelclock * (max_num_lanes / NUM_LANES_PER_BRICK);
