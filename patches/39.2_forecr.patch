+static void dione_ir_regmap_format_32_ble(void *buf, unsigned int val)
+{
+   u8 *b = buf;
+   int val_after;
+
+   b[0] = val >> 8;
+   b[1] = val;
+   b[2] = val >> 24;
+   b[3] = val >> 16;
+   val_after = *(int*)buf;
+}
