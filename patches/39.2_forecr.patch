diff --git a/source/hardware/nvidia/t23x/nv-public/nv-platform/Makefile b/source/hardware/nvidia/t23x/nv-public/nv-platform/Makefile
index baaab2e..fe95eb6 100644
--- a/source/hardware/nvidia/t23x/nv-public/nv-platform/Makefile
