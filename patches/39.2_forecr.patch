+ * Output 0 LSB = 25 °C (typ.)
+ * Formula: T(°C) = 25 + (raw_s16 / 256.0)
+ *
+ * For IIO: report in millidegrees Celsius
+ *   val  = 25000 + (raw_s16 * 1000) / 256
+ * ----------------------------------------------------------------------- */
+#define ISDS_TEMP_OFFSET_MDEGC       25000  /* 25 °C in milli-°C */
