+			complete_all(&chan->tegra_vi_channel[vi_port]->capture_data->capture_resp);
+		}
+
 		vi5_channel_stop_kthreads(chan);
+	}
 
 	/* csi stream/sensor(s) devices to be closed before vi channel */
 	tegra_channel_set_stream(chan, false);
