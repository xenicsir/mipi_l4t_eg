+            i2c_clients[i].i2c_locked = 1;
+            __ecctrl_i2c_timeout_set(i2c_client, 0);
+            args.data_address = address;
+            args.data = data;
+            args.data_size = size;
+            args.i2c_timeout = 0;
+            args.i2c_tries_max = 1;
+            args.cb = NULL;
+            err = __ecctrl_i2c_read_reg(i2c_client, &args);
+            i2c_clients[i].i2c_locked = 0;
+            return err;
+         }
+         else
+         {
+            return -EBUSY;
+         }
+      }
+   }
+   return -EINVAL;
+}
