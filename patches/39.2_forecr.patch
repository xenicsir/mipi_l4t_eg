+	bus@0 {
+		serial@3140000 { //for RS232-422-485 communication
+			status = "okay";
+			compatible = "nvidia,tegra194-hsuart";
+			reset-names = "serial";
+			clock-names = "serial";
+		};
+
+		serial@3110000 {
+			status = "okay";
+			reset-names = "serial";
+			clock-names = "serial";
+		};
+
+		padctl@3520000 {
+			status = "okay";
+
+			ports {
+				usb2-0 {
+					status = "okay";
+					vbus-supply = <&vdd_5v0_sys>;
+					mode = "otg";
+					usb-role-switch;
+					/delete-node/ port;
+					connector {
+						compatible = "usb-b-connector", "gpio-usb-b-connector";
+						label = "micro-USB";
+						type = "micro";
+						vbus-gpios = <&gpio TEGRA234_MAIN_GPIO(Z, 1) GPIO_ACTIVE_LOW>;
+					};
+				};
+
+				usb2-1 {
+					/delete-node/ port;
+				};
+
+				usb3-0 {
+					nvidia,usb2-companion = <1>;
+					status = "okay";
+					/delete-node/ port;
+				};
+
+				usb3-1 {
+					nvidia,usb2-companion = <2>;
+					status = "okay";
+					/delete-node/ port;
+				};
+
+				usb3-2 {
+					nvidia,usb2-companion = <3>;
+					status = "okay";
+				};
+			};
+		};
+
+		usb@3550000 {
+			status = "okay";
+			phys = <&{/bus@0/padctl@3520000/pads/usb2/lanes/usb2-0}>;
+			phy-names = "usb2-0";
+		};
+
+		ethernet@6800000 {
+			status = "disabled";
+		};
+		//ethernet@6900000 // already disabled
+		//ethernet@6a00000 // already disabled
+		//ethernet@6b00000 // already disabled
+
+		ethernet@2310000 { //EQOS
+			status = "okay";
+			nvidia,mdio_addr = <0>;
+			nvidia,mac-addr-idx = <0>;
+			nvidia,pause_frames = <1>;
+			local-mac-address = [1a 2b 3c 4d 5e 6f];
+			nvidia,phy-reset-gpio = <&gpio TEGRA234_MAIN_GPIO(G, 5) GPIO_ACTIVE_LOW>;
+			phy-mode = "rgmii-id";
+			phy-handle = <&phy>;
+			nvidia,max-platform-mtu = <16383>; //8000
+
+			mdio {
+				compatible = "nvidia,eqos-mdio";
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				phy: phy@0 {
+					compatible = "ethernet-phy-ieee802.3-c22";
+					reg = <0>;
+					nvidia,phy-rst-pdelay-msec = <224>; /* msec */
+					nvidia,phy-rst-duration-usec = <10000>; /* usec */
+					interrupt-parent = <&gpio>;
+					interrupts = <TEGRA234_MAIN_GPIO(G, 4) IRQ_TYPE_LEVEL_LOW>;
+					marvell,copper-mode;
+					/* Setup LED[2] as interrupt pin (active low), LED[0] as LINK, LED[1] as ACT */
+					marvell,reg-init = <0x03 0x12 0x7fff 0x880>, /* LED[2] = interrupt */
+					                   <0x03 0x10 0xff00 0x0030>; /* LED[0]=LINK only(0x0), LED[1]=ACT(0x3) */
+				};
+			};
+		};
+
+		i2c@c240000 {
+			status = "okay";
+
+			/delete-node/ typec@8;
+
+			pcf8574a: gpio@38 {
+				compatible = "nxp,pcf8574a";
+				reg = <0x38>;
+				gpio-controller;
+				#gpio-cells = <2>;
+			};
+		};
+
+		i2c@c250000 {
+			status = "okay";
+
+			tmp102: tmp102@49 { // Temperature Sensor
+				compatible = "ti,tmp102";
+				reg = <0x49>;
+				#thermal-sensor-cells = <0>;
+			};
+		};
+
+		pcie@14180000 { // PCIe x1 (C0)
+			status = "okay";
+			phys = <&p2u_hsio_0>;
+			phy-names = "p2u-0";
+		};
+
+		pcie@141e0000 { // PCIe x8 (C7)
+			status = "okay";
+			num-lanes = <8>;
+			phys = <&p2u_gbe_0>, <&p2u_gbe_1>, <&p2u_gbe_2>, <&p2u_gbe_3>,
+				   <&p2u_gbe_4>, <&p2u_gbe_5>, <&p2u_gbe_6>, <&p2u_gbe_7>;
+			phy-names = "p2u-0", "p2u-1", "p2u-2", "p2u-3", "p2u-4",
+					"p2u-5", "p2u-6", "p2u-7";
+		};
+
+		pcie@14100000 {
+			/delete-property/ nvidia,pex-wake-gpios;
+		};
+	};
+};
