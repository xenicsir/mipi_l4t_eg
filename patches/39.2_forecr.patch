+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				phy: phy@0 {
+					compatible = "ethernet-phy-ieee802.3-c22";
+					reg = <0>;
+					nvidia,phy-rst-pdelay-msec = <224>; /* msec */
+					nvidia,phy-rst-duration-usec = <10000>; /* usec */
+					interrupt-parent = <&gpio>;
+					interrupts = <TEGRA234_MAIN_GPIO(G, 4) IRQ_TYPE_LEVEL_LOW>;
+					marvell,copper-mode;
+					/* Setup LED[2] as interrupt pin (active low), LED[0] as LINK, LED[1] as ACT */
+					marvell,reg-init = <0x03 0x12 0x7fff 0x880>, /* LED[2] = interrupt */
+					                   <0x03 0x10 0xff00 0x0030>; /* LED[0]=LINK only(0x0), LED[1]=ACT(0x3) */
+				};
+			};
+		};
+
+		i2c@c240000 {
+			status = "okay";
+
+			/delete-node/ typec@8;
+		};
+
+		i2c@3190000 {
+			pca6416_ioexpander: ioexpander@20 {
+				compatible = "ti,pca6416";
+				reg = <0x20>;
+				gpio-controller;
+				#gpio-cells = <2>;
+				gpio-line-names = 
+				    "m2b_keyb1.w_disable1#",
+				    "m2b_keyb1.w_disable2#",
+				    "m2b_keyb1.fullcard_pwroff#",
+				    "m2b_keyb1.reset",
+				    "m2b_keyb2.w_disable1#",
+				    "m2b_keyb2.w_disable2#",
+				    "m2b_keyb2.fullcard_pwroff#",
+				    "m2b_keyb2.reset",
+				    "m2e_wdisable1",
+				    "m2e_wdisable2",
+				    "m2_keym1_alert#",
+				    "m2_keym2_alert#",
+				    "keye_alert#",
+				    "N/A",
+				    "N/A",
+				    "N/A";
+
+				ioexpander_outlow {
+					gpio-hog;
+					gpios = <3 0 7 0 8 0 9 0>;
+					output-low;
+				};
+
+				ioexpander_outhigh {
+					gpio-hog;
+					gpios = <0 0 1 0 2 0 4 0 5 0 6 0 10 0 11 0 12 0>;
+					output-high;
+				};
+			};
+		};
+
+		i2c@c250000 {
+			status = "okay";
+
+			// IMU & Temp Sensor 2536030320001 - 0x6b
+			imu@6b {
+				compatible  = "we,wsen-isds-2536030320001";
+				reg = <0x6b>;
+			};
+
+			// EEPROM CAT24C04WI-GT3 - 0x56
+		};
+
+		pcie@14180000 { // PCIe x1 (C0)
+			status = "okay";
+			phys = <&p2u_hsio_0>;
+			phy-names = "p2u-0";
+		};
+
+		pcie@141e0000 { // PCIe x8 (C7)
+			status = "disabled";
+		};
+
+		pcie@14100000 {
+			/delete-property/ nvidia,pex-wake-gpios;
+		};
+	};
+};
