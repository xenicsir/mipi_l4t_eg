+		i2c@c240000 {
+			status = "okay";
+			fusb301@25 {
+				compatible = "onsemi,fusb301";
+				reg = <0x25>;
+				status = "okay";
+				#address-cells = <1>;
+				#size-cells = <0>;
+				interrupt-parent = <&gpio>;
+				interrupts = <TEGRA234_MAIN_GPIO(Z, 1) IRQ_TYPE_LEVEL_LOW>;
+				connector@0 {
+					port@0 {
+						fusb_p0: endpoint {
+							remote-endpoint = <&typec_p0>;
+						};
+					};
+				};
+			};
+		};
+
+		/* PWM1, 40pin header, pin 15 */
+		pwm@3280000 {
+			status = "okay";
+		};
+
+		/* PWM3, FAN */
+		pwm@32a0000 {
+			status = "okay";
+		};
+
+		/* PWM5, 40pin header, pin 33 */
+		pwm@32c0000 {
+			status = "okay";
+		};
+
+		/* PWM7, 40pin header, pin 32 */
+		pwm@32e0000 {
+			status = "okay";
+		};
