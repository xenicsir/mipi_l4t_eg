// Base DTB — two IMX477 nodes, ACTIVE
/dts-v1/;
/ {
	compatible = "nvidia,tegra234";
	model = "Test Jetson Board";

	cam_i2cmux {
		#address-cells = <1>;
		#size-cells = <0>;

		i2c@0 {
			#address-cells = <1>;
			#size-cells = <0>;

			rbpcv3_imx477_a@1a {
				compatible = "ridgerun,imx477";
				reg = <0x1a>;
			};
		};

		i2c@1 {
			#address-cells = <1>;
			#size-cells = <0>;

			rbpcv3_imx477_c@1a {
				compatible = "ridgerun,imx477";
				reg = <0x1a>;
			};
		};
	};
};
