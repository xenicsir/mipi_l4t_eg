#!/bin/bash
#******************************************************************************
# environment - Common environment setup for L4T build scripts
#
# This file provides:
#   - Shared argument parsing for all l4t_* scripts
#   - Version-specific configuration (URLs, toolchains, etc.)
#   - Common variables (paths, directories, etc.)
#
# Usage (from other scripts):
#   . environment "$@"
#
# Arguments:
#   -v, --l4t-version VERSION      L4T version (required)
#   -V, --vendor VENDOR            Vendor: generic, forecr (default: generic)
#   -c, --carrier-board BOARD      Carrier board: generic, dsboard_ornx (default: depends on vendor)
#   -p, --package-version VERSION  Package version for delivery (optional)
#   -s, --standalone               Build standalone kernel with -eg suffix
#
# Examples:
#   . environment --l4t-version 36.4.3
#   . environment -v 36.4.3 -V forecr
#   . environment -v 36.4.3 -V forecr -c dsboard_ornx --standalone
#******************************************************************************

#******************************************************************************
# Argument parsing function
#******************************************************************************
parse_l4t_args() {
   # Reset variables
   L4T_VERSION=""
   VENDOR="generic"
   CARRIER_BOARD=""
   PACKAGE_VERSION=""
   STANDALONE_BUILD=0

   # Parse arguments
   while [[ $# -gt 0 ]]; do
      case "$1" in
         -v|--l4t-version)
            L4T_VERSION="$2"
            shift 2
            ;;
         -V|--vendor)
            VENDOR="$2"
            shift 2
            ;;
         -c|--carrier-board)
            CARRIER_BOARD="$2"
            shift 2
            ;;
         -p|--package-version)
            PACKAGE_VERSION="$2"
            shift 2
            ;;
         -s|--standalone)
            STANDALONE_BUILD=1
            shift
            ;;
         -h|--help)
            show_l4t_help
            exit 0
            ;;
         *)
            echo "Error: Unknown argument: $1"
            echo "Use --help for usage information."
            exit 1
            ;;
      esac
   done

   # Validate required arguments
   if [[ -z "$L4T_VERSION" ]]; then
      echo "Error: --l4t-version is required"
      echo "Use --help for usage information."
      exit 1
   fi

   # Validate vendor
   case "$VENDOR" in
      generic|forecr)
         ;;
      *)
         echo "Error: Invalid vendor '$VENDOR'. Valid values: generic, forecr"
         exit 1
         ;;
   esac

   # Set default carrier-board based on vendor
   if [[ -z "$CARRIER_BOARD" ]]; then
      case "$VENDOR" in
         generic)
            CARRIER_BOARD="generic"
            ;;
         forecr)
            CARRIER_BOARD="dsboard_ornx"
            ;;
      esac
   fi

   # Validate carrier-board
   case "$CARRIER_BOARD" in
      generic|dsboard_ornx)
         ;;
      *)
         echo "Error: Invalid carrier-board '$CARRIER_BOARD'. Valid values: generic, dsboard_ornx"
         exit 1
         ;;
   esac

   # Validate vendor + carrier-board combinations
   case "$VENDOR" in
      generic)
         if [[ "$CARRIER_BOARD" != "generic" ]]; then
            echo "Error: Vendor 'generic' only supports carrier-board 'generic'"
            exit 1
         fi
         ;;
      forecr)
         if [[ "$CARRIER_BOARD" != "dsboard_ornx" ]]; then
            echo "Error: Vendor 'forecr' only supports carrier-board 'dsboard_ornx'"
            exit 1
         fi
         ;;
   esac

   # Forecr vendor implies standalone build
   if [[ "$VENDOR" == "forecr" ]]; then
      STANDALONE_BUILD=1
   fi

   # Export STANDALONE_BUILD for use by other scripts
   export STANDALONE_BUILD
}

#******************************************************************************
# Help function
#******************************************************************************
show_l4t_help() {
   cat << 'EOF'
L4T Build System - Common Arguments

Usage:
  ./l4t_<script>.sh [options]

Required:
  -v, --l4t-version VERSION      L4T version (e.g., 36.4.3, 35.6.2, 32.7.1)

Optional:
  -V, --vendor VENDOR            Vendor: generic (default), forecr
  -c, --carrier-board BOARD      Carrier board (default depends on vendor):
                                   - generic: generic (uses tegra_defconfig)
                                   - forecr: dsboard_ornx (uses dsboard_ornx_defconfig)
  -p, --package-version VERSION  Package version for delivery package
  -s, --standalone               Build standalone kernel with -eg suffix
                                   (automatically enabled for forecr)
  -h, --help                     Show this help message

Valid combinations:
  --vendor generic --carrier-board generic      (default)
  --vendor forecr --carrier-board dsboard_ornx  (default for forecr)

Examples:
  ./l4t_build.sh -v 36.4.3
  ./l4t_build.sh -v 36.4.3 -V forecr
  ./l4t_build.sh -v 36.4.3 -V forecr -c dsboard_ornx
  ./l4t_build.sh -v 36.4.3 --standalone
  ./l4t_gen_delivery_package.sh -v 36.4.3 -V forecr -p 2.0.0

Supported L4T versions:
  32.7.1, 32.7.4, 32.7.5, 32.7.6
  35.1, 35.3.1, 35.4.1, 35.5.0, 35.6.0, 35.6.1, 35.6.2
  36.4, 36.4.3, 36.4.4
EOF
}

