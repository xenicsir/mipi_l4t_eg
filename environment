#******************************************************************************
# Helper function to check if vendor is supported for a version
check_vendor_support() {
   local supported_vendors="$1"
   if [[ ! " $supported_vendors " =~ " $VENDOR " ]]; then
      echo "Error: Vendor '$VENDOR' is not supported for L4T $L4T_VERSION"
      echo "Supported vendors: $supported_vendors"
      exit 1
   fi
}

